.ipynb_checkpoints/

# Ignore all cache
**/__pycache__/

**/credentials.json
**/token*.json

# Ignore everything in html/ except .gitkeep
job_details_scraper/html/*
!job_details_scraper/html/.gitkeep

# Ignore everything in text/ except .gitkeep
job_details_scraper/text/*
!job_details_scraper/text/.gitkeep

# Ignore sqlite open files for vscode extension
**/*-shm
**/*-wal

file_merger/*.txt

file_merger_batch/files/*
!file_merger_batch/files/.gitkeep

pdf_image_overlay/files/*
!pdf_image_overlay/files/.gitkeep

**/*.y*ml
!**/config.example.y*ml

url_extractor/*.txt
